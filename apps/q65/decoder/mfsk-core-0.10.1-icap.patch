+/// Precomputed, b90-dependent context for the **streaming** per-row
+/// fast-fading metric. Build once per `(submode, b90, model)` with
+/// [`fast_fading_row_ctx`], then apply to each symbol's single wide
+/// row with [`fast_fading_row`]. This lets a memory-constrained caller
+/// (e.g. the IC-9700 ICAP app) stream the wide-energy spectrogram from
+/// an SD backing store instead of holding all `N` symbol rows resident:
+/// the per-symbol intrinsic depends only on that symbol's own row,
+/// because the leading/trailing `M`-bin pad makes each fading window
+/// self-contained. Numerically identical to [`intrinsics_fast_fading`].
+pub struct FastFadingRowCtx {
+    big_m: usize,
+    bpt: usize,
+    bins_per_symbol: usize,
+    hlen: usize,
+    weights: Vec<f32>,
+}
+
+/// Build the per-row context. `raw_mean_energy` is
+/// `Sigma(all wide-energy bins) / (N * bins_per_symbol)` — the
+/// b90-independent global mean the caller accumulates while streaming
+/// the spectrogram out to its backing store. All other arguments match
+/// [`intrinsics_fast_fading`].
+pub fn fast_fading_row_ctx(
+    submode: u8,
+    b90_ts: f32,
+    model: FadingModel,
+    decoder_es_no_metric: f32,
+    raw_mean_energy: f32,
+) -> FastFadingRowCtx {
+    let big_m = 64usize;
+    let bpt = bins_per_tone(submode);
+    let bins_per_symbol = big_m * (2 + bpt);
+    let hidx = table_index(b90_ts);
+    let (hlen, taps) = match model {
+        FadingModel::Gaussian => (GAUSS_LEN[hidx], GAUSS_TAPS[hidx]),
+        FadingModel::Lorentzian => (LORENTZ_LEN[hidx], LORENTZ_TAPS[hidx]),
+    };
+    debug_assert_eq!(taps.len(), hlen, "fading table length mismatch");
+    let b90 = b90_ts / TS_QRA64;
+    let degrade_db = 8.0 * b90.ln() / MAX_SPREAD_HZ.ln();
+    let es_no_metric = decoder_es_no_metric * (degrade_db * (core::f32::consts::LN_10 / 10.0)).exp();
+    let noise_var = raw_mean_energy / (1.0 + es_no_metric / bins_per_symbol as f32);
+    let mut weights = vec![0.0_f32; hlen];
+    for k in 0..hlen {
+        let t = taps[k] * es_no_metric;
+        weights[k] = t / (1.0 + t) / noise_var;
+    }
+    FastFadingRowCtx { big_m, bpt, bins_per_symbol, hlen, weights }
+}
+
+/// The part of [`fast_fading_row_ctx`] that does not depend on the mean energy, Lorentzian model:
+/// the calibrated tap row for `b90_ts` and the Es/No metric degraded for that spread.  A caller that
+/// streams the spectrogram (and so learns the mean energy last) computes `t/(1+t)` weights from
+/// these, filters each row as [`fast_fading_row`] does, and divides by
+/// `noise_var = mean / (1 + es_no_metric / bins_per_symbol)` afterwards.
+pub struct LorentzTaps {
+    pub es_no_metric: f32,
+    pub taps: &'static [f32],
+}
+
+pub fn lorentz_taps(b90_ts: f32, decoder_es_no_metric: f32) -> LorentzTaps {
+    let hidx = table_index(b90_ts);
+    let b90 = b90_ts / TS_QRA64;
+    let degrade_db = 8.0 * b90.ln() / MAX_SPREAD_HZ.ln();
+    let es_no_metric = decoder_es_no_metric * (degrade_db * (core::f32::consts::LN_10 / 10.0)).exp();
+    LorentzTaps { es_no_metric, taps: &LORENTZ_TAPS[hidx][..LORENTZ_LEN[hidx]] }
+}
+
+
+/// Compute one symbol's `M` intrinsic probabilities from that symbol's
+/// single wide-energy row (`row.len() == bins_per_symbol`) into `out`
+/// (`out.len() == M`). Mirrors the per-symbol body of
+/// [`intrinsics_fast_fading`] exactly, but indexed within one row.
+pub fn fast_fading_row(ctx: &FastFadingRowCtx, row: &[f32], out: &mut [f32]) {
+    let big_m = ctx.big_m;
+    let bpt = ctx.bpt;
+    let hlen = ctx.hlen;
+    assert_eq!(row.len(), ctx.bins_per_symbol, "fast_fading_row: row must be bins_per_symbol");
+    assert_eq!(out.len(), big_m, "fast_fading_row: out must be M");
+    let hhsz = hlen - 1;
+    let hlast = 2 * hhsz;
+    // Central bin of tone 0 sits at local offset `big_m` within the row.
+    let first_bin = big_m - (hlen - 1);
+    let mut max_logp = 0.0_f32;
+    for k in 0..big_m {
+        let centre = first_bin + k * bpt;
+        let mut acc = 0.0_f32;
+        for j in 0..hhsz {
+            acc += ctx.weights[j] * (row[centre + j] + row[centre + hlast - j]);
+        }
+        acc += ctx.weights[hhsz] * row[centre + hhsz];
+        out[k] = acc;
+        if acc > max_logp {
+            max_logp = acc;
+        }
+    }
+    let mut sum = 0.0_f32;
+    for v in out.iter_mut() {
+        let x = (*v - max_logp).clamp(-85.0, 85.0);
+        let e = x.exp();
+        *v = e;
+        sum += e;
+    }
+    let inv = if sum > 0.0 { 1.0 / sum } else { 0.0 };
+    for v in out.iter_mut() {
+        *v *= inv;
+    }
+    pdmath::norm(out);
+}
